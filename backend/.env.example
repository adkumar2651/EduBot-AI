# Owner-managed Groq credentials. Keep this file free of real secrets.
GROQ_API_KEY=replace_with_your_Groq_API_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_TOKENS=800

# Generate a private random value for deployments.
SECRET_KEY=replace_with_a_random_secret

# Comma-separated frontend origins allowed to call this backend.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000

# Optional environment-managed administrator account.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional MongoDB persistence; the app uses memory storage if unavailable.
MONGO_URI=mongodb://localhost:27017/
DB_NAME=edubot_db

# Use a shared Redis URL for rate limits when deploying multiple instances.
RATELIMIT_STORAGE_URI=memory://
